rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== USER DOCUMENT =====
    match /users/{userId} {
      // Allow authenticated user to read their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow account creation with any fields (for mobile app signup)
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Allow any update from authenticated user (simplified for Phase 1)
      allow update: if request.auth != null && request.auth.uid == userId;
      
      allow delete: if false;

      // ===== SUBCOLLECTIONS =====
      
      // Subcollection: Generated Images
      match /generatedImages/{imageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Content (saved images, carousels, etc)
      match /content/{contentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Generated Videos
      match /generatedVideos/{videoId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: User Preferences
      match /preferences/{prefId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Notifications
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ===== PLANS/SUBSCRIPTION COLLECTION =====
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ===== USAGE TRACKING =====
    match /usage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}