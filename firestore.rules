rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== USER DOCUMENT =====
    match /users/{userId} {
      // Allow authenticated user to read their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow account creation with any fields (for mobile app signup)
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Allow any update from authenticated user (simplified for Phase 1)
      allow update: if request.auth != null && request.auth.uid == userId;
      
      allow delete: if request.auth != null && request.auth.uid == userId;

      // ===== SUBCOLLECTIONS =====
      
      // Subcollection: Generated Images
      match /generatedImages/{imageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Content (saved images, carousels, etc)
      match /content/{contentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Generated Videos
      match /generatedVideos/{videoId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: User Preferences
      match /preferences/{prefId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Library
      match /library/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Notifications
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ===== ADMIN CONTENT COLLECTION =====
    match /admin_content/{contentId} {
      // Anyone authenticated can read (for Trending display)
      allow read: if request.auth != null;
      // Authenticated users can create, update, delete (app enforces admin-only)
      allow create, update, delete: if request.auth != null;
    }

    // ===== PLANS/SUBSCRIPTION COLLECTION =====
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ===== USAGE TRACKING =====
    match /usage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ===== USAGE LOGS =====
    match /usage_logs/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ===== GENERATED HOLIDAY COLLECTION =====
    match /generated_holiday/{holidayId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // ===== PURCHASES TRACKING =====
    match /purchases/{purchaseId} {
      allow read: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ===== SUPPORT TICKETS =====
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ===== CONTENT REPORTS (App Store Guideline 1.2) =====
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}