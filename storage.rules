rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ===== PROFILE IMAGES =====
    match /users/{userId}/profile/{allPaths=**} {
      // Allow users to read their own profile images
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to upload/update their own profile images
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024 // Max 5MB
        && request.resource.contentType.matches('image/.*'); // Only images
    }

    // ===== GENERATED IMAGES =====
    match /users/{userId}/generatedImages/{imageId} {
      // Allow users to read their own generated images
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to upload generated images
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024 // Max 10MB
        && request.resource.contentType.matches('image/.*'); // Only images
      
      // Allow users to delete their own generated images
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ===== EDITED IMAGES =====
    match /users/{userId}/edits/{imageId} {
      // Allow users to read their own edited images
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to upload edited images
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024 // Max 10MB
        && request.resource.contentType.matches('image/.*'); // Only images
      
      // Allow users to delete their own edited images
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ===== GENERATED VIDEOS =====
    match /users/{userId}/generatedVideos/{videoId} {
      // Allow users to read their own generated videos
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to upload generated videos
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 100 * 1024 * 1024 // Max 100MB
        && request.resource.contentType.matches('video/.*'); // Only videos
      
      // Allow users to delete their own generated videos
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ===== REFERENCE IMAGES (Selfies) =====
    match /users/{userId}/referenceImages/{imageId} {
      // Allow users to read their own reference images
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to upload reference images (selfies)
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024 // Max 5MB
        && request.resource.contentType.matches('image/.*'); // Only images
      
      // Allow users to delete their own reference images
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ===== GENERATED CAROUSELS (ZIP files) =====
    match /users/{userId}/generatedCarousels/{carouselId} {
      // Allow users to read their own generated carousels
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to upload carousel ZIP files
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024 // Max 50MB for ZIP
        && request.resource.contentType == 'application/zip'; // Only ZIP files
      
      // Allow users to delete their own carousels
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ===== PUBLIC ASSETS (App logos, etc.) =====
    match /public/{allPaths=**} {
      // Allow anyone to read public assets
      allow read: if true;
      
      // Only allow authenticated users to write (for future admin uploads)
      allow write: if false; // Disable for now, enable for admin panel later
    }

    // ===== DENY ALL OTHER ACCESS =====
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
